# ========================================
# Accrual Automation Configuration
# ========================================

# Flask Application Configuration
FLASK_SECRET_KEY=your-secret-key-here-change-this-in-production
FLASK_PORT=5001

# Google Drive Configuration
# Get this from your Google Drive root folder URL
# Example: https://drive.google.com/drive/folders/1ABC...XYZ
# Use the ID after /folders/
ROOT_FOLDER_ID=your-google-drive-root-folder-id

# Gemini API Configuration
# Get this from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ========================================
# Google Credentials (automatically detected)
# ========================================
# The app will look for these files in the parent directory:
# - credentials.json (from Google Cloud Console)
# - token.json (generated on first run)
# - company_aliases.json (in ../app/)
# - entity_folder_structures.json (in ../app/)
